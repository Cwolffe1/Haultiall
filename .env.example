# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Server (set these in Render dashboard) ─────────────────────────────────────
PORT=3001
# CLIENT_URL accepts a comma-separated list for multiple Vercel URLs:
# CLIENT_URL=https://haultiall.vercel.app,https://haultiall-git-main-*.vercel.app
CLIENT_URL=http://localhost:5173

# ── Client (set in Vercel dashboard → Environment Variables) ───────────────────
# Points the frontend at the Render backend in production.
# Leave blank locally — Vite's dev proxy handles it.
# VITE_API_URL=https://haultiall-api.onrender.com

# ── Stripe (coming soon) ───────────────────────────────────────────────────────
